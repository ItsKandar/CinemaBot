# Token du bot Discord (https://discord.com/developers/applications)
DISCORD_TOKEN=

# Clé API TMDB : clé v3 (32 caractères) OU token v4 "Bearer" (commence par eyJ)
# https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Salon où sont postées les séances de cinéma
CINEMA_CHANNEL_ID=1545391737806262322

# ID du serveur : les commandes slash y sont synchronisées instantanément.
# Laisser vide pour une synchro globale (peut prendre jusqu'à 1h).
GUILD_ID=

# Langue des données TMDB
TMDB_LANGUAGE=fr-FR
